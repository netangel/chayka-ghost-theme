{
  "name": "chayka",
  "description": "Chayka — sailing journal theme (Raceway + Lora + Golos Text)",
  "version": "1.0.0",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "license": "MIT",
  "author": {
    "name": "Artem Krivopolenov",
    "email": "artem@krivopolenov.me"
  },
  "keywords": [
    "ghost-theme"
  ],
  "screenshots": {
    "desktop": "assets/screenshot-desktop.jpg"
  },
  "config": {
    "posts_per_page": 9,
    "card_assets": true,
    "image_sizes": {
      "xs": { "width": 150 },
      "s": { "width": 400 },
      "m": { "width": 750 },
      "l": { "width": 1200 },
      "xl": { "width": 2000 }
    },
    "custom": {
      "hero_height": {
        "type": "select",
        "options": ["short", "tall"],
        "default": "tall"
      }
    }
  }
}
