<nav class="pagination">
    <span class="mono pagination-count">Страница {{page}} из {{pages}}</span>
    <span class="pagination-links">
        {{#if prev}}<a class="btn btn-brass-outline" href="{{page_url prev}}">← Новые статьи</a>{{/if}}
        {{#if next}}<a class="btn btn-brass-outline" href="{{page_url next}}">Прошлые статьи →</a>{{/if}}
    </span>
</nav>
