{{!< default}}

{{#post}}
<article class="post">
    {{#if @page.show_title_and_feature_image}}
    <header class="post-hero{{#if feature_image}} hero-photo{{/if}}"{{#if feature_image}} style="background-image: url({{img_url feature_image size="xl"}})"{{/if}}>
        <div class="hero-scrim"></div>
        <div class="wrap post-hero-inner">
            <h1 class="post-title">{{title}}</h1>
        </div>
    </header>
    {{/if}}
    <div class="wrap">
        <div class="prose">
            {{content}}
        </div>
    </div>
</article>
{{/post}}
