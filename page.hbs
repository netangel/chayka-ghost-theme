{{!< default}}

{{#post}}
<article class="post">
    {{#if @page.show_title_and_feature_image}}
    <header class="page-head wrap">
        <h1 class="post-title post-title-plain">{{title}}</h1>
    </header>
    {{/if}}
    <div class="wrap">
        <div class="prose">
            {{#if @page.show_title_and_feature_image}}
                {{#if feature_image}}
                <figure class="kg-card kg-image-card">
                    <img class="kg-image" src="{{img_url feature_image size="l"}}" alt="{{title}}">
                </figure>
                {{/if}}
            {{/if}}
            {{content}}
        </div>
    </div>
</article>
{{/post}}
